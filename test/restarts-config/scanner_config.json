          "targets": ["tablet_server", "scan_server"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_batchscanner_partial_read",
          "targets": ["tablet_server", "scan_server"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_scanner_full_read",
          "targets": ["tablet_server", "scan_server"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_batchscanner_full_read",
          "targets": ["tablet_server", "scan_server"],
