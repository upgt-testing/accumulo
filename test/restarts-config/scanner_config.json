          "targets": ["tablet_server"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_scanner_iteration_no_readahead",
          "targets": ["tablet_server"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_scanner_setup_with_readahead",
          "targets": ["tablet_server"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
          "position": "after_scanner_iteration_with_readahead",
          "targets": ["tablet_server"],
          "modes": ["GRACEFUL", "CRASH"]
        }
      ]
    },
    {
      "testClass": "org.apache.accumulo.test.functional.ScannerIT_RestartInjected",
      "testMethod": "testSessionCleanup",
      "restartPoints": [
        {
          "position": "after_scan_server_start",
          "targets": ["scan_server"],
          "modes": ["GRACEFUL", "CRASH"]
        },
        {
